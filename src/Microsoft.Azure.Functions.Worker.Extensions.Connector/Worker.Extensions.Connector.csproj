<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Microsoft.Azure.Functions.Worker.Extensions.Connector</AssemblyName>
    <Description>Connector trigger extension for Azure Functions isolated worker with Webhook and preview Poll delivery</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Abstractions" Version="1.3.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Core" Version="2.52.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(SrcRoot)Shared\ConnectorContractConstants.cs"
             Link="Shared\ConnectorContractConstants.cs" />
  </ItemGroup>

  <!-- Link to the WebJobs (host-side) extension for extension discovery -->
  <ItemGroup>
    <WebJobsReference Include="$(SrcRoot)Microsoft.Azure.Functions.Extensions.Connector\Extensions.Connector.csproj" />
  </ItemGroup>

</Project>
